# ==============================================
# Environment Configuration
# ==============================================
# Copy this file as .env and fill in the values

# Test Environment: dev | staging | prod
TEST_ENV=staging

# Base URLs
BASE_URL_DEV=https://www.saucedemo.com
BASE_URL_STAGING=https://www.saucedemo.com
BASE_URL_PROD=https://www.saucedemo.com

# Test Credentials
TEST_USER_STANDARD=standard_user
TEST_USER_LOCKED=locked_out_user
TEST_USER_PROBLEM=problem_user
TEST_USER_PERFORMANCE=performance_glitch_user
TEST_USER_ERROR=error_user
TEST_USER_VISUAL=visual_user
TEST_PASSWORD=secret_sauce

# Browser Settings
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=30000
EXPECT_TIMEOUT=10000

# Retry Configuration
RETRY_COUNT=2
RETRY_DELAY=1000

# Parallel Workers
WORKERS=4

# Reporting
ALLURE_RESULTS_DIR=reports/allure-results
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_FAILURE=true

# API Settings
API_BASE_URL=https://reqres.in/api
API_TIMEOUT=15000

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#qa-automation
