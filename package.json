{
  "name": "mobile-automation-test-framework",
  "version": "1.0.0",
  "description": "Senior QA-level mobile web automation test framework with Playwright",
  "author": "QA Team",
  "license": "MIT",
  "scripts": {
    "test": "npx playwright test",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:regression": "npx playwright test --grep @regression",
    "test:e2e": "npx playwright test --grep @e2e",
    "test:visual": "npx playwright test --grep @visual",
    "test:api": "npx playwright test --grep @api",
    "test:mobile": "npx playwright test --project='iPhone 14'",
    "test:android": "npx playwright test --project='Pixel 7'",
    "test:tablet": "npx playwright test --project='iPad Pro 11'",
    "test:all-devices": "npx playwright test --project='iPhone 14' --project='Pixel 7' --project='iPad Pro 11'",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:trace": "npx playwright test --trace on",
    "test:parallel": "npx playwright test --workers=4",
    "test:retry": "npx playwright test --retries=2",
    "test:dev": "cross-env TEST_ENV=dev npx playwright test",
    "test:staging": "cross-env TEST_ENV=staging npx playwright test",
    "test:prod": "cross-env TEST_ENV=prod npx playwright test --grep @smoke",
    "test:a11y": "npx playwright test --grep @a11y",
    "test:performance": "npx playwright test --grep @performance",
    "test:security": "npx playwright test --grep @security",
    "test:mobile-specific": "npx playwright test --grep @mobile",
    "report:html": "npx playwright show-report reports/playwright-html",
    "report:allure:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "report:allure:open": "allure open reports/allure-report",
    "report:allure": "npm run report:allure:generate && npm run report:allure:open",
    "lint": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' '*.ts' 'config/**/*.ts'",
    "check": "npm run lint && npm run format",
    "clean": "rimraf reports/allure-results reports/allure-report reports/playwright-html test-results",
    "prepare": "husky"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.48.0",
    "allure-playwright": "^3.0.0",
    "axe-core": "^4.11.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "faker-js": "^1.0.0",
    "tslog": "^4.9.3",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "allure-commandline": "^2.30.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
